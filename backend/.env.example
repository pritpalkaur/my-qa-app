# Copy to .env and fill in DB_PASSWORD. .env is git-ignored.
DB_SERVER=PRITI_LAPTOP
# Leave blank to use the default local instance; set (e.g. 1433) to force TCP.
DB_PORT=
DB_NAME=HR_QA_DB
DB_USER=user1
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT_SECONDS=5
